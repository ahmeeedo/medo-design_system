  "descriptions": {
    "motion/duration/fast": "100 ms: feedback – hover, pressed, focus, color and opacity. Pressed starts at once and fades out, so a tap feels immediate.",
    "motion/duration/normal": "250 ms: small changes in place – fades, overlays in (popover, menu, tooltip), content swaps.",
    "motion/duration/slow": "350 ms: larger fades and the fallback where a spring cannot be used.",
    "motion/duration/smooth": "Perceptual duration of spring/smooth (SwiftUI .smooth: 0.5 s). Code turns spring + duration into a CSS linear() curve and its settle time.",
    "motion/duration/snappy": "Perceptual duration of spring/snappy. Code turns spring + duration into a CSS linear() curve and its settle time.",
    "motion/easing/standard": "cubic-bezier(0.32, 0.72, 0, 1): a strong ease-out (fast start, long soft landing) – state changes and movement within the view where no spring is used.",
    "motion/easing/enter": "cubic-bezier(0.16, 1, 0.3, 1): elements appearing – fast start, long soft landing.",
    "motion/easing/exit": "cubic-bezier(0.32, 0, 0.67, 0): elements leaving – accelerate out; exits are always shorter than entries.",
    "motion/spring/smooth": "Spring like SwiftUI .smooth (bounce 0, with duration/smooth): no overshoot. Everything that moves – sheets, drawers, dialogs, toasts, accordion, swipe.",
    "motion/spring/snappy": "Spring like SwiftUI .snappy (bounce 0.15, with duration/snappy): a hint of overshoot. Small controls – switch thumb, tab and segment indicator, checkbox and radio marks, slider thumb.",
    "focus/ring": "Focus ring color for all interactive elements. info/600 (sky/600) in both modes. Contrast ≥ 3:1 to focus/halo.",
    "focus/halo": "Solid halo between element and focus ring. Guarantees ring contrast on any surface (white / neutral-950).",
