{
  "name": "@med-o/ui",
  "version": "0.8.0",
  "description": "React components of the med.o Design System. Styles are plain CSS on top of @med-o/design-tokens and can be reused by other frameworks.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@med-o/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./styles.min.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/**/*.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@med-o/design-tokens": "0.8.0",
    "lucide-react": "^1.59.0",
    "react-aria-components": "^1.22.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^14.3.0",
    "lightningcss": "^1.32.0",
    "size-limit": "^14.3.0",
    "tsup": "^8.5.1"
  },
  "scripts": {
    "build": "tsup && node build-css.mjs",
    "prepack": "npm run build",
    "size": "size-limit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmeeedo/medo-design_system.git",
    "directory": "packages/ui"
  },
  "homepage": "https://design.med-o.de",
  "bugs": {
    "url": "https://github.com/ahmeeedo/medo-design_system/issues"
  },
  "keywords": [
    "design-system",
    "react",
    "react-aria",
    "components",
    "accessibility",
    "wcag"
  ],
  "publishConfig": {
    "access": "public"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "format": [
      "esm"
    ],
    "target": "es2022",
    "dts": true,
    "sourcemap": true,
    "clean": true,
    "banner": {
      "js": "\"use client\";"
    }
  },
  "size-limit": [
    {
      "name": "Button",
      "path": "dist/index.js",
      "import": "{ Button }",
      "gzip": true,
      "limit": "21 kB"
    },
    {
      "name": "QuickSearch",
      "path": "dist/index.js",
      "import": "{ QuickSearch }",
      "gzip": true,
      "limit": "61 kB"
    },
    {
      "name": "All components",
      "path": "dist/index.js",
      "import": "*",
      "gzip": true,
      "limit": "267 kB"
    },
    {
      "name": "Styles",
      "path": "dist/styles.css",
      "gzip": true,
      "limit": "23 kB",
      "rolldown": false
    }
  ]
}
