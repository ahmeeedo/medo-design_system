{
  "name": "@med-o/design-tokens",
  "version": "0.3.0",
  "description": "Design tokens of the med.o Design System (DTCG source, CSS variables, Tailwind v4 theme, JS).",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./css": "./dist/css/tokens.css",
    "./css/tokens.css": "./dist/css/tokens.css",
    "./css/typography.css": "./dist/css/typography.css",
    "./tailwind": "./dist/tailwind/theme.css",
    "./tailwind/theme.css": "./dist/tailwind/theme.css",
    "./js": {
      "types": "./dist/js/tokens.d.ts",
      "default": "./dist/js/tokens.js"
    },
    "./docs/*.json": "./dist/docs/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "style-dictionary": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmeeedo/medo-design_system.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://design.med-o.de",
  "bugs": {
    "url": "https://github.com/ahmeeedo/medo-design_system/issues"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "dtcg",
    "css-variables",
    "tailwindcss"
  ],
  "publishConfig": {
    "access": "public"
  }
}
